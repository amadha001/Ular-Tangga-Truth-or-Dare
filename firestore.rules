
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.playerUids;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.playerUids.size() == 1
        && request.auth.uid in request.resource.data.playerUids
        && request.resource.data.players.size() == 1
        && request.resource.data.status == 'lobby';

      allow update: if request.auth != null
        && request.resource.data.code == resource.data.code
        && request.resource.data.hostUid == resource.data.hostUid
        && (
          request.auth.uid in resource.data.playerUids
          || (
            resource.data.status == 'lobby'
            && request.resource.data.status == 'lobby'
            && request.auth.uid in request.resource.data.playerUids
            && request.resource.data.playerUids.size() == resource.data.playerUids.size() + 1
            && request.resource.data.players.size() == resource.data.players.size() + 1
            && request.resource.data.playerUids.size() <= 6
          )
        );

      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
